@model Smart_Park_D2.Models.ViewModels.AdminDashboardViewModel

<div class="row g-3 mb-4">

    <div class="col-6 col-md-3">
        <div class="card p-3 text-center">
            <p class="text-muted mb-1">Total Bookings</p>
            <h3>@Model.TotalBookings</h3>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card p-3 text-center">
            <p class="text-muted mb-1">Available Slots</p>
            <h3>@Model.AvailableSlots</h3>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card p-3 text-center">
            <p class="text-muted mb-1">Occupied Slots</p>
            <h3>@Model.OccupiedSlots</h3>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card p-3 text-center">
            <p class="text-muted mb-1">Total Revenue</p>
            <h3>Rs. @Model.TotalRevenue</h3>
        </div>
    </div>

</div>
