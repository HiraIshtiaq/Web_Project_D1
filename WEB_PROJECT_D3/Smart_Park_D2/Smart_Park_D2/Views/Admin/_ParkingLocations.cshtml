@model List<Smart_Park_D2.Models.ParkingLocation>

<div class="card mb-4">
    <div class="table-responsive">
        <table class="table table-hover mb-0">

            <thead class="table-light">
                <tr>
                    <th>Location</th>
                    <th>Address</th>
                    <th>Total Slots</th>
                    <th>Available Slots</th>
                    <th>Price / Hour</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var location in Model)
                    {
                        <tr>
                            <td>@location.Name</td>
                            <td>@location.Address</td>
                            <td>@location.TotalSlots</td>
                            <td>@(location.TotalSlots - location.OccupiedSlots)</td>
                            <td>Rs. @location.RatePerHour</td>

                            <td>
                                <a href="/Admin/UpdateLocation/@location.Id"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <form action="/Admin/DeleteLocation" method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this location?');">

                                    <input type="hidden" name="id" value="@location.Id" />

                                    <button type="submit" class="btn btn-danger btn-sm">
                                        Delete
                                    </button>

                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">
                            No parking locations found.
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>

